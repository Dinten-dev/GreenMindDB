# GreenMind — Production Environment Variables
# Copy to /opt/greenmind-prod/.env and fill in real values.

# ── Database ─────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION
POSTGRES_DB=plantdb
POSTGRES_PORT=5432

# ── Backend ──────────────────────────────────
ENVIRONMENT=production
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_PRODUCTION
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_DOMAIN=green-mind.ch
COOKIE_SECURE=true

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=https://green-mind.ch,https://www.green-mind.ch,https://greenmind.biolingo.org

# ── Email (Resend) ───────────────────────────
RESEND_API_KEY=
EMAIL_FROM=onboarding@green-mind.ch
FRONTEND_URL=https://green-mind.ch
CONTACT_FORM_TO=

# ── S3 / MinIO (REQUIRED – no defaults!) ─────
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
# Before deployment, create greenmind-raw and greenmind-photos, then provision an
# application account limited to list/read/write/delete access on those buckets.
S3_ACCESS_KEY_ID=CHANGE_ME_BUCKET_SCOPED_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_BUCKET_SCOPED_S3_SECRET_KEY
GATEWAY_RELEASE_SIGNING_PUBLIC_KEY_FILE=/etc/greenmind/gateway-release-signing-public.pem
MAX_WAV_UPLOAD_BYTES=33554432
MAX_WAV_BUNDLE_FILES=2000
MAX_WAV_BUNDLE_BYTES=2147483648
SENSOR_EXPORT_MAX_ROWS=250000
SENSOR_EXPORT_MAX_BYTES=67108864
SENSOR_EXPORT_MAX_KINDS=32

# ── Private Docker network / trusted Nginx peer ─────────
# Must not overlap another Docker, LAN, or VPN network on the host.
GREENMIND_DOCKER_SUBNET=172.28.20.0/24
GREENMIND_DOCKER_GATEWAY=172.28.20.1

# ── Ports ────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ASPSMS (Electrode Alerts)
ASPSMS_USERKEY=
ASPSMS_PASSWORD=
ASPSMS_SENDER_ID=GreenMind
