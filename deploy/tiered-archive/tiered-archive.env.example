# General later-phase template; NOT the first isolated staging copy profile.
# First staging: staging-copy.env.example and STAGING-REVIEW-V2.md.
# Merge with the existing reviewed RAW_ARCHIVE_* access/health profile only later.
# Use a dedicated PostgreSQL read role for archive capture.
# Writer access belongs only to the separately reviewed deletion deployment.
TIERED_ARCHIVE_ENABLED=false
TIERED_ARCHIVE_DELETE_ENABLED=false
TIERED_ARCHIVE_READS_ENABLED=false
TIERED_ARCHIVE_ENVIRONMENT=staging
TIERED_ARCHIVE_STATE_DIR=/var/lib/greenmind/tiered-archive
TIERED_ARCHIVE_FEATURE_READS_ACCEPTED=false
TIERED_ARCHIVE_DIRECT_LOCATORS_ACCEPTED=false
TIERED_ARCHIVE_SQL_RETENTION_ACCEPTED=false
TIERED_ARCHIVE_ACTIVATION_FILE=/etc/greenmind/tiered-activation.json
TIERED_ARCHIVE_ACTIVATION_SHA256=FILL_REVIEWED_ACTIVATION_SHA256
TIERED_ARCHIVE_SNAPSHOT_TOKEN_FILE=/etc/greenmind/storagebox-read-token
TIERED_ARCHIVE_BOX_ID=FILL_VERIFIED_STORAGEBOX_ID
TIERED_ARCHIVE_BACKUP_KEY_FILE=/etc/greenmind/database-backup.key
RETENTION_ENABLED=false
DIRECT_RETENTION_ENABLED=false
VISUAL_PRUNE_ENABLED=false
RAW_ARCHIVE_DELETE_ENABLED=false
DIRECT_PAYLOAD_RELEASE_REQUIRES_ARCHIVE=true
