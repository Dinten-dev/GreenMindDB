[Unit]
Description=GreenMind bounded verified archival cycle
After=network-online.target greenmind-source-link.service
Wants=network-online.target

[Service]
Type=oneshot
User=greenmind-archive
Group=greenmind-archive
Slice=greenmind-archive.slice
EnvironmentFile=/etc/greenmind/tiered-archive.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=/opt/greenmind/tiered-archive/current/python/bin/python -m app.tiered_archive tick --schedule /etc/greenmind/tiered-archive-schedule.json
WorkingDirectory=/opt/greenmind/tiered-archive/current/backend
UMask=0077
CPUQuota=25%
MemoryMax=192M
MemorySwapMax=0
TasksMax=16
IOWeight=10
Nice=15
TimeoutStartSec=360
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/greenmind/tiered-archive /var/lib/greenmind/archive-copy-20261010 /run/greenmind-archive
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
