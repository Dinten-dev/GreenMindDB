{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact copy-only WAV pilot (no discovery, snapshots or deletion)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment",
    "wav_jobs",
    "wav_limits"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "environment": {
      "enum": [
        "production",
        "staging"
      ]
    },
    "wav_jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "reference"
            ],
            "properties": {
              "source": {
                "const": "gateway"
              },
              "reference": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                  }
                ],
                "items": false,
                "minItems": 1,
                "maxItems": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "reference"
            ],
            "properties": {
              "source": {
                "const": "direct"
              },
              "reference": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        ]
      }
    },
    "wav_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wavs",
        "max_bytes"
      ],
      "properties": {
        "max_wavs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        }
      }
    }
  }
}
