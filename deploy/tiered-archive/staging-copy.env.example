# Source credentials: SELECT/GET on separate staging copies only.
# Destination credential: separate RW subaccount confined by the provider
# to greenmind-staging-20261026; not the production archive account.
RAW_ARCHIVE_ENVIRONMENT=staging
TIERED_ARCHIVE_ENVIRONMENT=staging
TIERED_ARCHIVE_ENABLED=false
TIERED_ARCHIVE_SOURCE_ORIGIN=isolated_staging_copy
TIERED_ARCHIVE_STATE_DIR=/var/lib/greenmind/tiered-archive/staging
RAW_ARCHIVE_STATE_DIR=/var/lib/greenmind/tiered-archive/staging/raw
RAW_ARCHIVE_WORKER_ROLE=isolated-staging
RAW_ARCHIVE_GATEWAY_DATABASE_URL=postgresql://FILL_READ_ROLE@127.0.0.1:26432/gateway_staging
RAW_ARCHIVE_DIRECT_DATABASE_URL=postgresql://FILL_READ_ROLE@127.0.0.1:26433/direct_staging
RAW_ARCHIVE_GATEWAY_S3_ENDPOINT=http://127.0.0.1:26900
RAW_ARCHIVE_GATEWAY_S3_BUCKET=greenmind-gateway-staging-20261026
RAW_ARCHIVE_DIRECT_S3_ENDPOINT=http://127.0.0.1:26900
RAW_ARCHIVE_DIRECT_S3_BUCKET=greenmind-direct-staging-review
RAW_ARCHIVE_GATEWAY_S3_ACCESS_KEY=FILL_STAGING_GET_ONLY_KEY
RAW_ARCHIVE_GATEWAY_S3_SECRET_KEY=FILL_STAGING_GET_ONLY_SECRET
RAW_ARCHIVE_DIRECT_S3_ACCESS_KEY=FILL_STAGING_GET_ONLY_KEY
RAW_ARCHIVE_DIRECT_S3_SECRET_KEY=FILL_STAGING_GET_ONLY_SECRET
RAW_ARCHIVE_HEALTH_URLS=http://127.0.0.1:26812/health,http://127.0.0.1:26803/health
RAW_ARCHIVE_SOURCE_MOUNTS=/var/lib/greenmind/tiered-archive/staging
RAW_ARCHIVE_MIN_AVAILABLE_MEMORY_MIB=1024
RAW_ARCHIVE_MAX_HOST_LOAD=2
RAW_ARCHIVE_MAX_LOAD_PER_CPU=0.5
RAW_ARCHIVE_SFTP_USER=FILL_STAGING_RW_SUBACCOUNT
RAW_ARCHIVE_SFTP_HOST=FILL_STAGING_RW_SUBACCOUNT.your-storagebox.de
RAW_ARCHIVE_SFTP_ROOT=greenmind-staging
RAW_ARCHIVE_SFTP_KEY=/etc/greenmind/tiered-archive/staging-upload.key
RAW_ARCHIVE_SFTP_KNOWN_HOSTS=/etc/greenmind/tiered-archive/staging-known-hosts
TIERED_ARCHIVE_MAX_WAV_BUNDLE_BYTES=5242880
TIERED_ARCHIVE_MAX_SQL_PAGE_BYTES=1048576
TIERED_ARCHIVE_BACKUP_KEY_SHA256=FILL_SHA256_OF_RECOVERED_KEY
TIERED_ARCHIVE_DELETE_ENABLED=false
RAW_ARCHIVE_DELETE_ENABLED=false
RETENTION_ENABLED=false
DIRECT_RETENTION_ENABLED=false
VISUAL_PRUNE_ENABLED=false
