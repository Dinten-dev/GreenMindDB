# Separate staging RO subaccount, never an existing production credential.
# Do not copy RAW_ARCHIVE_SFTP_* or database URLs into this profile.
TIERED_ARCHIVE_ENVIRONMENT=staging
RAW_ARCHIVE_ENVIRONMENT=staging
TIERED_ARCHIVE_READS_ENABLED=true
TIERED_ARCHIVE_DELETE_ENABLED=false
RAW_ARCHIVE_DELETE_ENABLED=false
TIERED_ARCHIVE_STATE_DIR=/var/lib/greenmind/tiered-archive/staging
RAW_ARCHIVE_STATE_DIR=/var/lib/greenmind/tiered-archive/staging/raw
TIERED_ARCHIVE_READ_BROKER_SOCKET=/run/greenmind-tiered-archive-staging/history.sock
RAW_ARCHIVE_READ_ONLY_SFTP_USER=FILL_READ_ONLY_SUBACCOUNT
RAW_ARCHIVE_READ_ONLY_SFTP_HOST=FILL_READ_ONLY_SUBACCOUNT_HOST
RAW_ARCHIVE_READ_ONLY_SFTP_KEY=/etc/greenmind/tiered-archive/staging-reader.key
RAW_ARCHIVE_READ_ONLY_SFTP_KNOWN_HOSTS=/etc/greenmind/tiered-archive/staging-known-hosts
TIERED_ARCHIVE_BACKUP_KEY_SHA256=FILL_SHA256_OF_RECOVERED_KEY
