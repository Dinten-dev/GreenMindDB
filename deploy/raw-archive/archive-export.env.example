# PREPARED ONLY. Separate read-only archive access; no receiving-service changes.
ARCHIVE_EXPORTS_ENABLED=false
ARCHIVE_EXPORT_STATE_DIR=/var/lib/greenmind-archive-export
RAW_ARCHIVE_READS_ENABLED=false
RAW_ARCHIVE_READS_ACCEPTED=false
RAW_ARCHIVE_DELETE_ENABLED=false
RAW_ARCHIVE_MAX_FILE_BYTES=67108864
RAW_ARCHIVE_STATE_DIR=/var/lib/greenmind-raw-copy
RAW_ARCHIVE_ENVIRONMENT=production
RAW_ARCHIVE_SFTP_HOST=FILL_STORAGEBOX_HOST
RAW_ARCHIVE_SFTP_USER=FILL_READ_ONLY_SUBACCOUNT
RAW_ARCHIVE_SFTP_KEY=FILL_PRIVATE_READ_ONLY_KEY
RAW_ARCHIVE_SFTP_KNOWN_HOSTS=FILL_PINNED_HOSTKEY
RAW_ARCHIVE_SFTP_ROOT=greenmind-raw
RAW_ARCHIVE_SFTP_PORT=23
RAW_ARCHIVE_GATEWAY_DATABASE_URL=FILL_READ_ONLY_URL
RAW_ARCHIVE_DIRECT_DATABASE_URL=FILL_READ_ONLY_URL
RAW_ARCHIVE_GATEWAY_S3_ENDPOINT=FILL_ENDPOINT
RAW_ARCHIVE_GATEWAY_S3_ACCESS_KEY=FILL_READ_ONLY_ACCESS
RAW_ARCHIVE_GATEWAY_S3_SECRET_KEY=FILL_READ_ONLY_SECRET
RAW_ARCHIVE_DIRECT_S3_ENDPOINT=FILL_ENDPOINT
RAW_ARCHIVE_DIRECT_S3_BUCKET=FILL_DIRECT_BUCKET
RAW_ARCHIVE_DIRECT_S3_ACCESS_KEY=FILL_READ_ONLY_ACCESS
RAW_ARCHIVE_DIRECT_S3_SECRET_KEY=FILL_READ_ONLY_SECRET
# DIRECT_* read-sidecar settings, DATABASE_URL and cookie auth configuration
# must be taken from the existing isolated read deployment.
# The read sidecar and worker must share the same unprivileged UID and 0700
# export directory; the journal and SSH key must be readable by that UID.
# Supply the existing application's auth and read-sidecar DB settings separately.
