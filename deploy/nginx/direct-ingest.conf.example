# Include only in the reviewed STAGING HTTPS server block.
# Existing location blocks stay unchanged. Set DIRECT_TRUSTED_PROXY_IPS to the
# actual Docker bridge peer, never '*', and verify scheme detection in staging.
location ^~ /api/v1/direct-ingest/ {
    client_max_body_size 64k;
    client_body_timeout 20s;
    proxy_connect_timeout 5s;
    proxy_read_timeout 35s;
    proxy_send_timeout 25s;
    proxy_request_buffering on;
    proxy_pass http://127.0.0.1:8002;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Authorization $http_authorization;
}
