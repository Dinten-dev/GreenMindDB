# GreenMind local stack — environment variables
# Copy this file to .env and replace every CHANGE_ME value.

# ── Database ─────────────────────────────────
POSTGRES_USER=plantuser
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=plantdb
POSTGRES_PORT=5432
PGDATA_DIR=postgres_data

# ── Backend ──────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
FIRMWARE_STORAGE_DIR=/app/firmware_data
GATEWAY_RELEASE_DIR=/app/firmware_data/gateway_releases
GATEWAY_RELEASE_SIGNING_PUBLIC_KEY_PATH=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_DOMAIN=
COOKIE_SECURE=false
ENABLE_EXPERIMENTAL_PROVISIONING=false
ENABLE_EXPERIMENTAL_BIOSIGNAL=false
MAX_WAV_UPLOAD_BYTES=33554432
MAX_WAV_BUNDLE_FILES=2000
MAX_WAV_BUNDLE_BYTES=2147483648
SENSOR_EXPORT_MAX_ROWS=250000
SENSOR_EXPORT_MAX_BYTES=67108864
SENSOR_EXPORT_MAX_KINDS=32
RETENTION_ENABLED=false
RETENTION_DRY_RUN=true
RETENTION_INTERVAL_HOURS=24
RETENTION_BATCH_SIZE=500
RETENTION_MAX_BATCHES_PER_RUN=10
RETENTION_WAV_DAYS=90
RETENTION_WAV_FEATURE_DAYS=730
RETENTION_ANOMALY_DAYS=365
RETENTION_FLAC_DAYS=365
RETENTION_SENSOR_READING_DAYS=180
RETENTION_INGEST_LOG_DAYS=30
RETENTION_GATEWAY_STATE_DAYS=30
RETENTION_PAIRING_DAYS=30
RETENTION_PROVISIONING_DAYS=30
WAV_FEATURE_EXTRACTION_ENABLED=true
WAV_FEATURE_INTERVAL_MINUTES=5
WAV_FEATURE_ACTIVE_INTERVAL_SECONDS=5
WAV_FEATURE_BATCH_SIZE=20
WAV_FEATURE_MAX_ATTEMPTS=5
WAV_ANOMALY_ARCHIVE_ENABLED=false
WAV_ANOMALY_CLIP_SECONDS=30
WAV_FLAC_ARCHIVE_ENABLED=false
EMBEDDED_BACKGROUND_WORKERS_ENABLED=false
STORAGE_CAPACITY_BYTES=107374182400
WEBSOCKET_MAX_CONNECTIONS=500
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5
WEBSOCKET_MAX_CONNECTIONS_PER_IP=20
WEBSOCKET_IDLE_TIMEOUT_SECONDS=300
WEBSOCKET_SEND_TIMEOUT_SECONDS=2

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Email (Resend) ───────────────────────────
RESEND_API_KEY=
EMAIL_FROM=onboarding@yourdomain.com
FRONTEND_URL=http://localhost:3000
CONTACT_FORM_TO=hello@yourdomain.com

# ── S3 / MinIO ───────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_DATA_DIR=minio_data
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-central-1
# Used when running the backend outside root Compose. Keep these equal to
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD for the bundled local MinIO instance.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_ROOT_PASSWORD

# ── Private Docker network / trusted proxies ────────────
# Review these for conflicts with host/VPN networks before first startup.
GREENMIND_DOCKER_SUBNET=172.28.10.0/24
GREENMIND_DOCKER_GATEWAY=172.28.10.1
FRONTEND_PROXY_IP=172.28.10.10

# ── Ports ────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090

# ── ASPSMS (optional electrode alerts) ───────
ASPSMS_USERKEY=
ASPSMS_PASSWORD=
ASPSMS_SENDER_ID=GreenMind
