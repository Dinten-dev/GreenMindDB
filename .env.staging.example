# GreenMind — Staging Environment Variables
# Copy to /opt/greenmind-staging/.env and fill in real values.

# ── Database ─────────────────────────────────
POSTGRES_USER=plantuser
POSTGRES_PASSWORD=CHANGE_ME_STAGING
POSTGRES_DB=plantdb_staging
POSTGRES_PORT=5433

# ── Backend ──────────────────────────────────
ENVIRONMENT=staging
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_STAGING
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_DOMAIN=test.green-mind.ch
COOKIE_SECURE=true

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=https://test.green-mind.ch

# ── Email (Resend) ───────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@green-mind.ch
FRONTEND_URL=https://test.green-mind.ch
CONTACT_FORM_TO=

# ── S3 / MinIO ───────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_STAGING
# Before deployment, create greenmind-raw and greenmind-photos, then provision an
# application account limited to list/read/write/delete access on those buckets.
S3_ACCESS_KEY_ID=CHANGE_ME_BUCKET_SCOPED_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_BUCKET_SCOPED_S3_SECRET_KEY
GATEWAY_RELEASE_SIGNING_PUBLIC_KEY_FILE=/etc/greenmind/gateway-release-signing-public.pem
MAX_WAV_UPLOAD_BYTES=33554432
MAX_WAV_BUNDLE_FILES=2000
MAX_WAV_BUNDLE_BYTES=2147483648
SENSOR_EXPORT_MAX_ROWS=250000
SENSOR_EXPORT_MAX_BYTES=67108864
SENSOR_EXPORT_MAX_KINDS=32
RETENTION_ENABLED=false
RETENTION_DRY_RUN=true
RETENTION_INTERVAL_HOURS=24
RETENTION_BATCH_SIZE=500
RETENTION_MAX_BATCHES_PER_RUN=10
RETENTION_WAV_DAYS=90
RETENTION_WAV_FEATURE_DAYS=730
RETENTION_ANOMALY_DAYS=365
RETENTION_FLAC_DAYS=365
RETENTION_SENSOR_READING_DAYS=180
RETENTION_INGEST_LOG_DAYS=30
RETENTION_GATEWAY_STATE_DAYS=30
RETENTION_PAIRING_DAYS=30
RETENTION_PROVISIONING_DAYS=30
WAV_FEATURE_EXTRACTION_ENABLED=true
WAV_FEATURE_INTERVAL_MINUTES=5
WAV_FEATURE_ACTIVE_INTERVAL_SECONDS=5
WAV_FEATURE_BATCH_SIZE=20
WAV_FEATURE_MAX_ATTEMPTS=5
WAV_ANOMALY_ARCHIVE_ENABLED=false
WAV_ANOMALY_CLIP_SECONDS=30
WAV_FLAC_ARCHIVE_ENABLED=false
EMBEDDED_BACKGROUND_WORKERS_ENABLED=false
STORAGE_CAPACITY_BYTES=107374182400
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003

# ── Private Docker network / trusted Nginx peer ─────────
# Distinct from production; must not overlap a host LAN or VPN network.
GREENMIND_DOCKER_SUBNET=172.28.21.0/24
GREENMIND_DOCKER_GATEWAY=172.28.21.1

# ── Ports ────────────────────────────────────
BACKEND_PORT=8001
FRONTEND_PORT=3001

# ASPSMS (Electrode Alerts)
ASPSMS_USERKEY=
ASPSMS_PASSWORD=
ASPSMS_SENDER_ID=GreenMind
