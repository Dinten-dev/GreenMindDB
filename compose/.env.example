# Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://green-mind.example
COOKIE_SECURE=true

# Account verification (required outside isolated development)
RESEND_API_KEY=change-me-resend-api-key
EMAIL_FROM=onboarding@green-mind.example
FRONTEND_URL=https://green-mind.example
CONTACT_FORM_TO=security@green-mind.example

# Proxy / TLS
GREENMIND_DOMAIN=localhost
CADDY_TLS_MODE=internal
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Private Docker network. Caddy has a fixed address so only that exact peer is
# trusted to supply X-Forwarded-* client identity headers to the API.
GREENMIND_DOCKER_SUBNET=172.28.30.0/24
GREENMIND_DOCKER_GATEWAY=172.28.30.1
CADDY_PROXY_IP=172.28.30.10

# Database
POSTGRES_DB=greenmind
POSTGRES_USER=greenmind
POSTGRES_PASSWORD=change-me-db-password

# JWT Auth
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars-long-xxxx
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
GATEWAY_RELEASE_SIGNING_PUBLIC_KEY_FILE=/etc/greenmind/gateway-release-signing-public.pem
MAX_WAV_UPLOAD_BYTES=33554432
MAX_WAV_BUNDLE_FILES=2000
MAX_WAV_BUNDLE_BYTES=2147483648
SENSOR_EXPORT_MAX_ROWS=250000
SENSOR_EXPORT_MAX_BYTES=67108864
SENSOR_EXPORT_MAX_KINDS=32
RETENTION_ENABLED=false
RETENTION_DRY_RUN=true
RETENTION_INTERVAL_HOURS=24
RETENTION_BATCH_SIZE=500
RETENTION_MAX_BATCHES_PER_RUN=10
RETENTION_WAV_DAYS=90
RETENTION_WAV_FEATURE_DAYS=730
RETENTION_ANOMALY_DAYS=365
RETENTION_FLAC_DAYS=365
RETENTION_SENSOR_READING_DAYS=180
RETENTION_INGEST_LOG_DAYS=30
RETENTION_GATEWAY_STATE_DAYS=30
RETENTION_PAIRING_DAYS=30
RETENTION_PROVISIONING_DAYS=30
WAV_FEATURE_EXTRACTION_ENABLED=true
WAV_FEATURE_INTERVAL_MINUTES=5
WAV_FEATURE_ACTIVE_INTERVAL_SECONDS=5
WAV_FEATURE_BATCH_SIZE=20
WAV_FEATURE_MAX_ATTEMPTS=5
WAV_ANOMALY_ARCHIVE_ENABLED=false
WAV_ANOMALY_CLIP_SECONDS=30
WAV_FLAC_ARCHIVE_ENABLED=false
EMBEDDED_BACKGROUND_WORKERS_ENABLED=false
STORAGE_CAPACITY_BYTES=107374182400

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-central-1
# Pre-create greenmind-raw and greenmind-photos, then grant this application
# account only list/read/write/delete access on those buckets.
S3_ACCESS_KEY_ID=greenmind-app
S3_SECRET_ACCESS_KEY=change-me-bucket-scoped-s3-secret

# MinIO root credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-root-password

# Monitoring (optional profile)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
