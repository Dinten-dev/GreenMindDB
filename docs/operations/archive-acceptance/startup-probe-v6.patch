+def sync_and_advise_pgdata(root, pin, health_callback, *, max_files=3000,
+                           max_bytes=512 * 1024**2):
+    """Flush and evict only pinned, newly created PG files without reading them."""
+    expected_dev, expected_ino, expected_uid = pin
+    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY
+    root_fd = os.open(root, flags)
+    total_files = total_bytes = entries = 0
+    try:
+        data_fd = os.open("pgdata", flags, dir_fd=root_fd)
+        try:
+            info = os.fstat(data_fd)
+            need((info.st_dev, info.st_ino, info.st_uid, stat.S_IMODE(info.st_mode))
+                 == (expected_dev, expected_ino, expected_uid, 0o700), "pgdata_pin")
+
+            def visit(dirfd):
+                nonlocal total_files, total_bytes, entries
+                health_callback()
+                for name in os.listdir(dirfd):
+                    entries += 1
+                    need(entries <= max_files * 2, "pgdata_entry_bound")
+                    if entries % 32 == 0:
+                        health_callback()
+                    before = os.stat(name, dir_fd=dirfd, follow_symlinks=False)
+                    need(before.st_dev == expected_dev and before.st_uid == expected_uid,
+                         "pgdata_entry_identity")
+                    if stat.S_ISDIR(before.st_mode):
+                        fd = os.open(name, flags, dir_fd=dirfd)
+                        try:
+                            after = os.fstat(fd)
+                            need((after.st_dev, after.st_ino, after.st_uid) ==
+                                 (before.st_dev, before.st_ino, before.st_uid),
+                                 "pgdata_entry_race")
+                            visit(fd)
+                        finally:
+                            os.close(fd)
+                    else:
+                        need(stat.S_ISREG(before.st_mode) and before.st_nlink == 1,
+                             "pgdata_regular_only")
+                        total_files += 1
+                        total_bytes += before.st_size
+                        need(total_files <= max_files and total_bytes <= max_bytes,
+                             "pgdata_file_bound")
+                        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
+                                     dir_fd=dirfd)
+                        try:
+                            after = os.fstat(fd)
+                            need(stat.S_ISREG(after.st_mode) and after.st_nlink == 1 and
+                                 (after.st_dev, after.st_ino, after.st_uid, after.st_size) ==
+                                 (before.st_dev, before.st_ino, before.st_uid, before.st_size),
+                                 "pgdata_entry_race")
+                            os.fsync(fd)
+                            os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
+                        finally:
+                            os.close(fd)
+            visit(data_fd)
+        finally:
+            os.close(data_fd)
+    finally:
+        os.close(root_fd)
+    return {"files": total_files, "logical_bytes": total_bytes}
