+def test_v6_devnull_owned_child_cleanup(tmp_path):
+    child = subprocess.Popen([sys.executable, "-c", "pass"], stdout=subprocess.DEVNULL,
+                             stderr=subprocess.DEVNULL)
+    out, err, timed_out = controller.owned_wait(child, 5, tmp_path, "Forward")
+    assert (out, err, timed_out) == (b"", b"", False)
+    terminal = json.loads((tmp_path / "Forward.Terminal.json").read_text())
+    assert terminal["stdout_capture"] == terminal["stderr_capture"] == "not_requested"
+    assert (tmp_path / "Forward.stdout").read_bytes() == b""
+
