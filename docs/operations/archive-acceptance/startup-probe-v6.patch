+def test_v6_pgdata_advice_no_content_read_and_rejects_unsafe_entries(tmp_path, monkeypatch):
+    import source_supervisor as source
+    data = tmp_path / "pgdata"
+    data.mkdir(mode=0o700)
+    file = data / "one"
+    file.write_bytes(b"private content")
+    info = data.stat()
+    pin = (info.st_dev, info.st_ino, info.st_uid)
+    calls = []
+    monkeypatch.setattr(source.os, "posix_fadvise", lambda fd, start, length, advice:
+                        calls.append((start, length, advice)), raising=False)
+    monkeypatch.setattr(source.os, "POSIX_FADV_DONTNEED", 4, raising=False)
+    monkeypatch.setattr(source.os, "read", lambda *args: pytest.fail("content read"))
+    checkpoints = []
+    result = source.sync_and_advise_pgdata(tmp_path, pin, lambda: checkpoints.append(1))
+    assert result == {"files": 1, "logical_bytes": 15}
+    assert calls == [(0, 0, 4)] and checkpoints
+    with pytest.raises(Exception):
+        source.sync_and_advise_pgdata(tmp_path, pin, lambda: None, max_bytes=14)
+    with pytest.raises(Exception):
+        source.sync_and_advise_pgdata(tmp_path, pin, lambda: None, max_files=0)
+    with pytest.raises(Exception):
+        source.sync_and_advise_pgdata(tmp_path, (pin[0] + 1, *pin[1:]), lambda: None)
+    with pytest.raises(Exception):
+        source.sync_and_advise_pgdata(tmp_path, (*pin[:2], pin[2] + 1), lambda: None)
+    file.unlink()
+    (data / "link").symlink_to(tmp_path)
+    with pytest.raises(Exception):
+        source.sync_and_advise_pgdata(tmp_path, pin, lambda: None)
+    (data / "link").unlink()
+    outside = tmp_path / "external"
+    outside.write_bytes(b"x")
+    os.link(outside, data / "hardlink")
+    with pytest.raises(Exception):
+        source.sync_and_advise_pgdata(tmp_path, pin, lambda: None)
+
+
+@pytest.mark.parametrize("field", ["device", "owner"])
+def test_v6_pgdata_rejects_foreign_entry(tmp_path, monkeypatch, field):
+    import source_supervisor as source
+    data = tmp_path / "pgdata"
+    data.mkdir(mode=0o700)
+    (data / "file").write_bytes(b"x")
+    info = data.stat()
+    actual_stat = os.stat
+    def foreign(path, *args, **kwargs):
+        result = actual_stat(path, *args, **kwargs)
+        if path == "file":
+            vals = list(result)
+            vals[2 if field == "device" else 4] += 1
+            return os.stat_result(vals)
+        return result
+    monkeypatch.setattr(source.os, "stat", foreign)
+    with pytest.raises(ValueError, match="pgdata_entry_identity"):
+        source.sync_and_advise_pgdata(tmp_path, (info.st_dev, info.st_ino, info.st_uid), lambda: None)
+
+
+def test_v6_pgdata_advice_failure_is_closed(tmp_path, monkeypatch):
+    import source_supervisor as source
+    data = tmp_path / "pgdata"
+    data.mkdir(mode=0o700)
+    (data / "file").write_bytes(b"x")
+    info = data.stat()
+    def fail(*args):
+        raise OSError("unavailable")
+    monkeypatch.setattr(source.os, "POSIX_FADV_DONTNEED", 4, raising=False)
+    monkeypatch.setattr(source.os, "posix_fadvise", fail, raising=False)
+    with pytest.raises(OSError):
+        source.sync_and_advise_pgdata(tmp_path, (info.st_dev, info.st_ino, info.st_uid), lambda: None)
