+class RelayCheckpoint:
+    """Check control every loop and resource health at most 250ms apart nominally."""
+
+    def __init__(self, control, full_check, heartbeat, *, monotonic=time.monotonic):
+        self.control = control
+        self.full_check = full_check
+        self.heartbeat = heartbeat
+        self.monotonic = monotonic
+        self.last_check = None
+        self.metrics = None
+
+    def __call__(self):
+        self.control.checkpoint()
+        now = self.monotonic()
+        if self.last_check is None or now - self.last_check >= 0.25:
+            self.metrics = self.full_check()
+            self.last_check = now
+        self.heartbeat(self.metrics)
+
+    def next_wait(self):
+        if self.last_check is None:
+            return 0.0
+        return max(0.0, min(0.1, self.last_check + 0.25 - self.monotonic()))
 
 
