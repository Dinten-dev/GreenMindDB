# PREPARED ONLY. Local isolated tests authorized; live policy remains DISABLED.
RAW_ARCHIVE_ENABLED=false
RAW_ARCHIVE_DELETE_ENABLED=false
RAW_ARCHIVE_READS_ACCEPTED=false
RAW_ARCHIVE_READS_ENABLED=false
# Reader flag belongs in every API/projection/feature process that reads archived RAWs.
# Optional private existing scratch directory; defaults to a secure per-request temporary dir.
# RAW_ARCHIVE_READ_SCRATCH_DIR=/var/cache/greenmind-archive-reads
# SSH-only alternative: a private host broker holds the pinned SSH key.
# Public API/export worker get only a read-only socket mount, never the key/journal.
# RAW_ARCHIVE_READ_BROKER_SOCKET=/broker/read.sock
RAW_ARCHIVE_ENVIRONMENT=production
RAW_ARCHIVE_STATE_DIR=/var/lib/greenmind-raw-archive
RAW_ARCHIVE_MAX_FILES=5000
RAW_ARCHIVE_MAX_FILE_BYTES=8388608
RAW_ARCHIVE_MAX_SECONDS=3600
RAW_ARCHIVE_MAX_BYTES=1073741824
RAW_ARCHIVE_MAX_REFERENCES=10000
RAW_ARCHIVE_PAGE_SIZE=100
RAW_ARCHIVE_SETTLE_SECONDS=600
RAW_ARCHIVE_RECHECK_DAYS=7
RAW_ARCHIVE_MIN_AVAILABLE_MEMORY_MIB=1024
RAW_ARCHIVE_MAX_HOST_LOAD=2
# Actual local receiver/assembler health endpoints, separated by commas.
RAW_ARCHIVE_HEALTH_URLS=FILL_GATEWAY_AND_DIRECT_HEALTH_URLS
RAW_ARCHIVE_SOURCE_MOUNTS=FILL_ABSOLUTE_SOURCE_MOUNT_PATHS
# Dedicated SELECT-only accounts. Never use receiver credentials.
RAW_ARCHIVE_GATEWAY_DATABASE_URL=FILL_READONLY_GATEWAY_POSTGRES_URL
RAW_ARCHIVE_DIRECT_DATABASE_URL=FILL_READONLY_DIRECT_POSTGRES_URL
# Start with S3 Get/Head-only credentials. For separately accepted deletion, use
# scoped GetObjectVersion/DeleteObjectVersion and version/lifecycle inspection.
# Never allow unversioned DeleteObject, PutObject or changes to bucket configuration.
RAW_ARCHIVE_GATEWAY_S3_ENDPOINT=FILL_GATEWAY_S3_HTTPS_OR_LOOPBACK_URL
RAW_ARCHIVE_GATEWAY_S3_ACCESS_KEY=FILL_GATEWAY_READONLY_ACCESS_KEY
RAW_ARCHIVE_GATEWAY_S3_SECRET_KEY=FILL_GATEWAY_READONLY_SECRET_KEY
RAW_ARCHIVE_DIRECT_S3_ENDPOINT=FILL_DIRECT_S3_HTTPS_OR_LOOPBACK_URL
RAW_ARCHIVE_DIRECT_S3_BUCKET=FILL_GREENMIND_DIRECT_PRODUCTION_BUCKET
RAW_ARCHIVE_DIRECT_S3_ACCESS_KEY=FILL_DIRECT_READONLY_ACCESS_KEY
RAW_ARCHIVE_DIRECT_S3_SECRET_KEY=FILL_DIRECT_READONLY_SECRET_KEY
# Use a separate worker identity. Verify the fingerprint out-of-band before use.
RAW_ARCHIVE_SFTP_HOST=u676312.your-storagebox.de
RAW_ARCHIVE_SFTP_USER=u676312
RAW_ARCHIVE_SFTP_PORT=23
RAW_ARCHIVE_SFTP_ROOT=greenmind-raw
RAW_ARCHIVE_SFTP_KEY=/etc/greenmind/raw-archive/storagebox_key
RAW_ARCHIVE_SFTP_KNOWN_HOSTS=/etc/greenmind/raw-archive/known_hosts
RAW_ARCHIVE_SFTP_KILOBITS=8192
# Both older destructive retention workers must remain disabled at activation.
RETENTION_ENABLED=false
DIRECT_RETENTION_ENABLED=false
