{
  "name": "greenmind-frontend",
  "version": "3.0.0",
  "private": true,
  "description": "GreenMind — Next.js frontend for plant bioelectrical signal visualization",
  "author": "Traver Dinten",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10.9 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json}' '*.{js,mjs,json,ts}' '!package-lock.json'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,json}' '*.{js,mjs,json,ts}' '!package-lock.json'",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "next": "16.3.1",
    "next-intl": "^4.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "2.2.0",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.4.33",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.3"
  }
}
